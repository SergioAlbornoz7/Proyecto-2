<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
   <head>
        {{> header}}
       <meta charset="UTF-8">
       <title>Principal</title>
       {{> menu}}
   </head>
   <body>
    <main class="principal">
        <section class="contenedor">
            <label for="Informacion" class="titulo-info">Sobre el juego</label>
            <input type="checkbox" id="Informacion" class="check" data-target="INFO">

            <div class="cuadro-info oculto1" id="INFO">

                <div class="portada">
                    <img src="/imagenes/portada.png" alt="Portada del juego">
                </div>

                <div class="descripcion">
                    <h2>ProyectMixII</h2>
                    <p>
                        Aquí puedes escribir una descripción del juego, su historia, mecánicas,
                        inspiración, modos de juego, etc.
                    </p>
                </div>

                <div class="capturas">
                    <img src="/imagenes/cap1.png">
                    <img src="/imagenes/cap2.png">
                    <img src="/imagenes/cap3.png">
                </div>
            </div>
        </section>
        <table>
    <thead>
        <tr>
            <th>Nº Batalla (ID)</th>
            <th>ID Civilització</th>
            <th>Nom Civilització</th>
            <th>Fusta (Wood)</th>
            <th>Ferro (Iron)</th>
            <th>Menjar (Food)</th>
            <th>Manà (Mana)</th>
        </tr>
    </thead>

    <tbody>
        {{#each Battles}}
        <tr>
            <td>{{this.num_battle}}</td>
            <td>{{this.civilization_id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.wood_amount}}</td>
            <td>{{this.iron_amount}}</td>
            <td>{{this.food_amount}}</td>
            <td>{{this.mana_amount}}</td>
        </tr>
        {{else}}
        <tr>
            <td colspan="7">No s'han trobat dades de batalles o civilitzacions de les últimes partides.</td>
        </tr>
        {{/each}}
    </tbody>
</table>

    </main>
  


    <script src="java.js"></script>

   {{> footer}}
   </body>
</html> 
